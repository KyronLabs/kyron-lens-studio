{
  "name": "kyron-lens-studio",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Draw a lens, place it on a face, publish it.",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "vectors": "node --test test/vectors.test.js",
    "vectors:refresh": "curl -fsSL https://raw.githubusercontent.com/KyronLabs/kyron-lenses/main/format-vectors.json -o test/format-vectors.json && npm run vectors",
    "anchors": "node tools/derive-anchors.mjs",
    "vendor": "node tools/vendor.mjs",
    "start": "npm run vendor && electron .",
    "shots": "npm run vendor && node tools/shoot.mjs",
    "dist": "npm run vendor && electron-builder --win --publish never",
    "test:format": "node --test \"test/*.test.js\"",
    "test:app": "npm run vendor && node tools/exercise.mjs"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "25.1.8",
    "kyron-design-system": "github:KyronLabs/design-system",
    "three": "0.169.0"
  },
  "build": {
    "appId": "so.kyron.lensstudio",
    "productName": "Kyron Lens Studio",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon/icon.ico",
      "signAndEditExecutable": true
    },
    "copyright": "Copyright (c) KyronLabs",
    "directories": {
      "output": "dist",
      "buildResources": "assets/icon"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kyron Lens Studio",
      "artifactName": "KyronLensStudio-Setup-${version}.${ext}"
    }
  },
  "author": "KyronLabs"
}
